# EGDesk MCP proxy (local dev)
NEXT_PUBLIC_EGDESK_API_URL=http://localhost:8080
NEXT_PUBLIC_EGDESK_API_KEY=

# Do not put SUPABASE_URL or the anon key on published sites.
# Visitor Google login is brokered by EGDesk. Add these to Supabase Auth redirect URLs
# (once per EGDesk / tunnel origin — not each published site):
#   http://localhost:54321/auth/callback
#   https://tunneling-service.onrender.com/**
#
# On a published tunnel host, NEXT_PUBLIC_EGDESK_API_URL must be the MCP root
# (https://…/t/{tunnelId}), not the /p/{project} app URL.
